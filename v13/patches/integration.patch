+### supabase_schema.sql
@@
 ALTER TABLE public.beta_feedback ENABLE ROW LEVEL SECURITY;
 -- Intentionally no browser policies: these tables are accessed through the Python backend with the service-role key.
+
+-- V13 monetization. Server-managed; never expose service-role access to the browser.
+CREATE TABLE IF NOT EXISTS public.billing_entitlements (
+  subject_hash text PRIMARY KEY,
+  plan text NOT NULL DEFAULT 'free',
+  status text NOT NULL DEFAULT 'active',
+  valid_until timestamptz,
+  source text,
+  stripe_customer_id text,
+  stripe_subscription_id text,
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
+ALTER TABLE public.billing_entitlements ENABLE ROW LEVEL SECURITY;
+-- Intentionally no browser policy. The Python backend mirrors billing state with the service-role key.
